# GPS SISTEMA C.A. — Variables de entorno requeridas
# Copia este archivo como .env y completa los valores reales (nunca subas .env a git)

# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Bot de Telegram — clientes
TELEGRAM_CLIENT_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot de Telegram — soporte interno
TELEGRAM_SUPPORT_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IDs de Telegram de los administradores (separados por coma)
TELEGRAM_SUPPORT_ADMIN_CHAT_IDS=123456789,987654321

# Sesión segura (genera uno aleatorio: openssl rand -hex 32)
SESSION_SECRET=cambia_esto_por_un_valor_aleatorio_largo
