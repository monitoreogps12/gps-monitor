# =============================================================================
# GPS SISTEMA C.A. — Variables de entorno para producción (Contabo)
# Guardar en: /root/gps-config/.env
# Permisos:   chmod 600 /root/gps-config/.env
# =============================================================================

NODE_ENV=production
PORT=3000

# ── Base de datos PostgreSQL local ───────────────────────────────────────────
# El script 1-setup-server.sh genera las credenciales automáticamente.
# Cópialas desde /root/gps-config/db-credentials.txt
APP_DATABASE_URL=postgresql://gpsadmin:TU_CONTRASEÑA@localhost:5432/gpsadmin

# ── Plataforma GPS (rastreoplus247.com) ──────────────────────────────────────
GPS_URL=https://rastreoplus247.com
GPS_EMAIL=olintoflores1@gmail.com
GPS_PASSWORD=Olinto1234

# ── Telegram ──────────────────────────────────────────────────────────────────
# Token del bot de Telegram (el mismo que usas en Replit)
TELEGRAM_BOT_TOKEN=TU_TOKEN_AQUI

# ── Sesiones HTTP ────────────────────────────────────────────────────────────
# Cadena aleatoria larga (mínimo 32 caracteres)
# Genera una con: openssl rand -base64 48
SESSION_SECRET=GENERA_UNA_CADENA_ALEATORIA_LARGA_AQUI
